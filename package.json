{
  "name": "xadboom",
  "version": "0.1.0",
  "private": true,
  "description": "Xadboom Atelier — curated interior architecture storefront, admin panel and API (Next.js monorepo).",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @xadboom/db generate",
    "db:migrate": "pnpm --filter @xadboom/db migrate:dev",
    "db:seed": "pnpm --filter @xadboom/db seed",
    "legacy": "node legacy/server.js"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
