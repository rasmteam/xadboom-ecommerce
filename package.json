{
  "name": "xadboom",
  "version": "0.1.0",
  "private": true,
  "description": "Xadboom Atelier — curated interior architecture storefront, admin panel and API (Next.js monorepo).",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:api": "pnpm --filter @xadboom/api dev",
    "dev:web": "pnpm --filter @xadboom/web dev",
    "db:generate": "pnpm --filter @xadboom/db generate",
    "db:migrate": "pnpm --filter @xadboom/db migrate:dev",
    "db:seed": "pnpm --filter @xadboom/db seed",
    "legacy": "node legacy/server.js",
    "dev:db": "node scripts/dev-db.mjs",
    "start:api": "node scripts/with-env.mjs node apps/api/dist/main.js",
    "start:web": "node scripts/with-env.mjs pnpm --filter @xadboom/web start",
    "setup:local": "pnpm --filter @xadboom/db build && node scripts/with-env.mjs pnpm --filter @xadboom/db migrate:deploy && node scripts/with-env.mjs pnpm --filter @xadboom/db seed && pnpm --filter @xadboom/api build && pnpm --filter @xadboom/web build",
    "test": "pnpm --filter @xadboom/api test",
    "e2e": "node e2e/smoke.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "16.15.0-beta.19",
    "playwright": "^1.64.1",
    "turbo": "^2.11.10"
  }
}
