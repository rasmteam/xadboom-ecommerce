# --- Database (docker-compose uses the service name "db") ---
POSTGRES_USER=xadboom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xadboom
DATABASE_URL=postgresql://xadboom:change-me@localhost:5432/xadboom?schema=public

# --- API (NestJS, apps/api) ---
API_PORT=4000
# generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# "false" only for plain-http local testing; keep true behind https
COOKIE_SECURE=false
UPLOAD_DIR=./uploads

# --- Web (Next.js, apps/web): where server-side rendering reaches the API ---
API_URL=http://localhost:4000

# --- Seed ---
SEED_ADMIN_EMAIL=admin@xadboom.local
SEED_ADMIN_PASSWORD=change-me-now
