# --- Database (docker-compose uses the service name "db") ---
POSTGRES_USER=xadboom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xadboom
# local dev DB started by `pnpm dev:db` (no Docker). Docker compose builds its own URL from the POSTGRES_* values.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/xadboom?schema=public

# --- API (NestJS, apps/api) ---
API_PORT=4010
# generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# "false" only for plain-http local testing; keep true behind https
COOKIE_SECURE=false
UPLOAD_DIR=./.local/uploads

# --- Web (Next.js, apps/web): where server-side rendering reaches the API ---
API_URL=http://localhost:4010
APP_URL=http://localhost:3010
PORT=3010

# --- Seed ---
SEED_ADMIN_EMAIL=admin@xadboom.local
SEED_ADMIN_PASSWORD=change-me-now
