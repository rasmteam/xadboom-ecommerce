# --- Database (docker-compose uses the service name "db") ---
POSTGRES_USER=xadboom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xadboom
DATABASE_URL=postgresql://xadboom:change-me@localhost:5432/xadboom?schema=public

# --- App ---
APP_URL=http://localhost:3000
# generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# --- Uploads (images, 3D models, Excel). Mount a persistent disk here in production. ---
UPLOAD_DIR=./uploads

# --- Currency defaults (admin can change these in Settings) ---
DEFAULT_CURRENCY_MODE=USD
DEFAULT_USD_TO_TOMAN=
