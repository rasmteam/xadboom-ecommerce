    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.0",
    "prisma": "7.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ]
}
